# Copy to a private .env file. Generate two different secrets with the command in DEPLOY.txt.
HOST=127.0.0.1
PORT=17896
DATA_DIR=/var/lib/dex-themes
UPLOAD_TOKEN=
ADMIN_TOKEN=
# Empty is correct for the desktop app: requests originate in its main process.
# Only add exact HTTPS origins if a browser frontend is intentionally connected.
CORS_ORIGINS=
